# =============================================================================
#  Meridian Bank AI Security Range: deployment settings  (range.env)
#
#  Fill this in once, put it next to meridian-range-installer.sh on the VM, then run:
#      sudo bash meridian-range-installer.sh
#
#  Re-run the same command after any change here, or to deploy a newer installer.
#  Your data and the generated secrets are kept on every run.
#
#  This file holds passwords and API keys: keep it private (the installer makes
#  it root-only and keeps a copy at /etc/airange/range.env for later runs).
# =============================================================================

# ---- Address --------------------------------------------------------------------
# The hostname learners will open. Two choices:
#   * your own domain, e.g. airange.collabace.com. Before installing, add DNS A records
#     for it AND for gateway.<it>, both pointing at the VM's IP;
#   * no domain yet: <VM-IP>.sslip.io, e.g. 172.236.162.184.sslip.io (works at once).
# Leave blank to use <this VM's IP>.sslip.io automatically.
DOMAIN=

# ---- First administrator ----------------------------------------------------------
# This email can sign in with Google AND with the password below.
ADMIN_EMAIL=you@example.com
# 12+ characters. Only used when the account has no password yet; change it later in
# Admin > My account. Leave blank to have one generated and printed at the end.
ADMIN_PASSWORD=

# ---- Google sign-in for learners (optional) -----------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
#   Authorized JavaScript origin:  https://<DOMAIN>
#   Authorized redirect URI:       https://<DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only let these email domains sign in with Google (comma-separated). Blank = anyone.
ALLOWED_EMAIL_DOMAINS=

# ---- Model provider API keys (optional; leave blank to skip a provider) -------------
# Stored root-only in /etc/airange/providers.env and given ONLY to the LiteLLM gateway,
# so a learner who makes an agent leak its environment never sees them.
# Groq: console.groq.com > API Keys (free tier, no card). Models: groq-llama-8b, groq-llama-70b, groq-gpt-oss-20b
GROQ_API_KEY=
# Gemini: aistudio.google.com > Get API key.                Model: gemini-flash-lite
GEMINI_API_KEY=
# Claude: console.anthropic.com > Settings > API keys.      Models: claude-haiku, claude-sonnet
ANTHROPIC_API_KEY=

# Which model every agent should use. Blank = leave agents as they are (new installs use
# the built-in offline mock model, which needs no key).
# Examples: groq-llama-8b, groq-llama-70b, gemini-flash-lite, claude-haiku, mock-gullible-1
AGENT_MODEL=

# ---- Tracing (optional) -----------------------------------------------------------
# Free project at cloud.langfuse.com > Settings > API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Components --------------------------------------------------------------------
# LLM Guard scanners need ~3 GB of RAM. auto = install only on VMs with 6 GB or more.
LLM_GUARD=auto          # auto | yes | no
# Ollama runs small open-weights models on the VM's CPU (slow without a GPU).
OLLAMA=no               # yes | no

# =============================================================================
#  Model provider API keys  — /etc/airange/providers.env  (root:root, mode 600)
#
#  Only the LiteLLM gateway (airange-litellm) loads this file. The app, LLM Guard
#  and the MCP demo server never see these keys, so a learner who gets an agent
#  to leak its environment or read files on disk does not get your provider keys.
#
#  Leave a key blank to skip that provider: its models still show in
#  Admin > LLM gateway, but calls to them fail with an auth error.
#  After editing:  sudo systemctl restart airange-litellm
# =============================================================================

# Claude — console.anthropic.com > Settings > API keys
ANTHROPIC_API_KEY=

# Gemini — aistudio.google.com > Get API key
GEMINI_API_KEY=

# Groq — console.groq.com > API Keys
GROQ_API_KEY=

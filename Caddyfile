# Main site: the Meridian Bank range, admin portal and the bank's MCP endpoint (/mcp/)
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080
	header Strict-Transport-Security "max-age=31536000"
}

# LiteLLM gateway UI and API (login with LITELLM_UI_USERNAME / LITELLM_UI_PASSWORD; API needs a key)
gateway.{$DOMAIN} {
	encode gzip
	reverse_proxy litellm:4000
}

# Langfuse (profile: observability). Sign-up is disabled; log in with LANGFUSE_INIT_USER_*.
langfuse.{$DOMAIN} {
	encode gzip
	reverse_proxy langfuse-web:3000
}

# MinIO for Langfuse media uploads (profile: observability)
minio.{$DOMAIN} {
	reverse_proxy minio:9000
}

# ============================================================================
#  Meridian Bank · AI Security Range  — copy to .env  (scripts/gen-env.sh fills every secret for you)
# ============================================================================
DOMAIN=range.example.com
BASE_URL=https://range.example.com
ENVIRONMENT=production
# Which optional stacks to run: observability (Langfuse), guard (LLM Guard), ollama. Comma-separated.
COMPOSE_PROFILES=observability,guard

# ---- App ---------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Authorised redirect URI: https://<DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
ALLOWED_EMAIL_DOMAINS=
APP_NAME=Meridian Bank · AI Security Range
DEFAULT_EMBEDDER=fastembed
MAX_MESSAGES_PER_USER_PER_DAY=200
DEV_LOGIN_ENABLED=false

# ---- LiteLLM gateway (https://gateway.<DOMAIN>) ------------------------------------
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# ---- Langfuse (https://langfuse.<DOMAIN>, profile: observability) -----------------
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_PROJECT_ID=meridian-range
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_PASSWORD=
REDIS_PASSWORD=

# ---- LLM Guard (profile: guard) and MCP demo -----------------------------------
LLM_GUARD_TOKEN=
MCP_DEMO_CONTROL_TOKEN=

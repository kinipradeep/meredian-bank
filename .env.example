# =============================================================================
#  Meridian Bank · AI Security Range  — /opt/airange/.env
#  scripts/gen-env.sh creates this file with every secret randomised.
# =============================================================================
DOMAIN=range.example.com
BASE_URL=https://range.example.com
ENVIRONMENT=production
APP_NAME="Meridian Bank · AI Security Range"

# ---- App ---------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
DEFAULT_EMBEDDER=fastembed
FASTEMBED_CACHE=/var/lib/airange/models
MAX_MESSAGES_PER_USER_PER_DAY=200
DEV_LOGIN_ENABLED=false

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Authorised redirect URI: https://<DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
ALLOWED_EMAIL_DOMAINS=

# ---- LiteLLM gateway (systemd: airange-litellm, 127.0.0.1:4000) -----------------
# Provider API keys (Claude, Gemini, Groq) do NOT go here: put them in /etc/airange/providers.env
# (template: deploy/providers.env.example). Only the gateway can read that file.
LITELLM_URL=http://127.0.0.1:4000
LITELLM_PUBLIC_URL=
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the gateway. NEVER change it after the first start.
LITELLM_SALT_KEY=
LITELLM_DATABASE_URL=
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=

# ---- LLM Guard (systemd: airange-llm-guard, 127.0.0.1:8001) ---------------------
LLMGUARD_URL=http://127.0.0.1:8001
LLMGUARD_TOKEN=

# ---- Langfuse Cloud (free Hobby tier): cloud.langfuse.com > project > Settings > API keys
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=

# ---- MCP demo server (systemd: airange-mcp-demo, 127.0.0.1:8765) ----------------
MCP_DEMO_URL=http://127.0.0.1:8765/mcp
MCP_DEMO_CONTROL_TOKEN=
